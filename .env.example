APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_FORCE_HTTPS=false
AUTH_ALLOW_REGISTRATION=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Glamhouse notifications
GLAMHOUSE_ADMIN_EMAIL=
GLAMHOUSE_WHATSAPP_ENABLED=false
GLAMHOUSE_WHATSAPP_PROVIDER=meta
GLAMHOUSE_WHATSAPP_ADMIN_NUMBER=
GLAMHOUSE_META_WHATSAPP_TOKEN=
GLAMHOUSE_META_PHONE_NUMBER_ID=
GLAMHOUSE_META_API_VERSION=v21.0

# SEO and indexing
SEO_SITE_NAME="Esther's Secrets - Glamhouse"
SEO_DEFAULT_IMAGE=/images/home-hero-fallback.jpg
SEO_DEFAULT_ROBOTS=index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1
SEO_TWITTER_CARD=summary_large_image
SEO_TWITTER_SITE=
SEO_FACEBOOK_APP_ID=
GOOGLE_SITE_VERIFICATION=
BUSINESS_NAME="Esther's Secrets - Glamhouse"
BUSINESS_DESCRIPTION="Skincare-first professional makeup artistry in Harare."
BUSINESS_PHONE=+263784721479
BUSINESS_EMAIL=
BUSINESS_STREET_ADDRESS=
BUSINESS_CITY=Harare
BUSINESS_REGION=Harare
BUSINESS_POSTAL_CODE=
BUSINESS_COUNTRY=ZW

# Admin credential bootstrap (optional)
ADMIN_DEFAULT_NAME="Studio Admin"
ADMIN_DEFAULT_EMAIL=
ADMIN_DEFAULT_PASSWORD=
